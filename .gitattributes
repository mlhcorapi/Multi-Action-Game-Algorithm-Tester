*.bin binary
*.jar binary
*.png binary
# Files whose bytes are hashed into provenance (specs, result tables): the same bytes on
# every platform, whatever core.autocrlf says, so a hash recorded on one machine matches the file on another.
*.csv text eol=lf
*.json text eol=lf
experiments/** text eol=lf
# A currency's bytes are hashed into every run's provenance: the same bytes on every platform too.
*.properties text eol=lf
# The notebooks are generated: the same bytes on every platform, so a regeneration shows only what changed.
*.ipynb text eol=lf
# The paper's tables are compared byte for byte with a rebuild (python magat.py paper --check): LF everywhere too.
paper/tables/** text eol=lf
*.pdf binary
