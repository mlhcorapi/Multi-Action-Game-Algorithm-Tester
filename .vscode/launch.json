{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "MAGAT: list the Tribes arms",
      "request": "launch",
      "mainClass": "magat.cli.Main",
      "args": "arms --game tribes",
      "vmArgs": "-Dtribes.home=${workspaceFolder}/games/tribes/engine",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Tribes: play (the engine's own GUI)",
      "request": "launch",
      "mainClass": "Play",
      "cwd": "${workspaceFolder}/games/tribes/engine"
    }
  ]
}
